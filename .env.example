EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=https://babyvom.it

# Optional. Error monitoring and product analytics stay off until these are set.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Redesigned screens are the default; 0 = show the old screens instead.
# PostHog's `redesign` flag and the in-app preview toggle take precedence.
EXPO_PUBLIC_REDESIGN=
