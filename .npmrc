# ponytail: SDK 58 preview only. React Native 0.88.0-rc.1 is a prerelease, so
# npm won't match it against ranges like "0.86 - 0.88" (Reanimated, Worklets).
# This also stops npm auto-installing peers, which is why test-renderer and
# @react-native/metro-config are listed in package.json. Delete this file when
# SDK 58 ships stable on react-native 0.88.0.
legacy-peer-deps=true
