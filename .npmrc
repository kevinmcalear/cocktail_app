# ponytail: React Native 0.88.0-rc.3 is still a prerelease, so npm won't match
# it against ranges like "0.86 - 0.88" (Reanimated, Worklets). This also stops
# npm auto-installing peers, which is why test-renderer and
# @react-native/metro-config are listed in package.json. Delete this file when
# Expo bundles react-native 0.88.0 with no prerelease tag.
legacy-peer-deps=true
