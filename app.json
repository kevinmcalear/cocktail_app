{
  "expo": {
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": true } }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F9FB",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#161618"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use your photos so you can add pictures of drinks, menus, venue logos and your profile.",
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to photograph drinks, and to read a menu, bottle or recipe you point it at.",
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone when you tap the mic to say a drink."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "$(PRODUCT_NAME) uses your location to show bars and drinks near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Allow $(PRODUCT_NAME) to read motion so the map can show which way you're facing."
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/redaction/Redaction-Regular.ttf",
            "./assets/fonts/redaction/Redaction-Italic.ttf",
            "./assets/fonts/redaction/Redaction-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1d3d8eeb-0e87-4f06-ba38-2db32b8d4d02"
      }
    },
    "owner": "kevinmcalear"
  }
}
