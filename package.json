{
  "name": "cocktail_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start",
    "android": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start --android",
    "ios": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start --ios",
    "web": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start --web",
    "lint": "expo lint",
    "build:web": "APP_VARIANT=production TAMAGUI_DISABLE_SLIDER_INTERVAL=1 expo export -p web && node scripts/write-web-manifest.mjs && cp dist/+not-found.html dist/404.html",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-checks.mjs && node --test \"scripts/__tests__/*.test.mjs\"",
    "check:design": "node --no-warnings=ExperimentalWarning scripts/design-ratchet.mjs",
    "test:jest": "jest",
    "test:security": "node --test \"supabase/tests/*.test.mjs\"",
    "test:policy": "npm ci --prefix scripts/change-policy --ignore-scripts --no-audit --no-fund --silent && node --test \"scripts/change-policy/*.test.mjs\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react": "10.37.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.95.2",
    "@tamagui/config": "2.7.7",
    "@tanstack/query-async-storage-persister": "^5.90.23",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.23",
    "babel-preset-expo": "~57.0.0",
    "base64-arraybuffer": "^1.0.2",
    "burnt": "^0.13.0",
    "expo": "~57.0.0",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "posthog-react-native": "^4.77.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tamagui": "2.7.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "pg": "^8.23.0",
    "postinstall-postinstall": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
