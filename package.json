{
  "name": "cocktail_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start",
    "android": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start --android",
    "ios": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start --ios",
    "web": "NODE_OPTIONS=\"--max-old-space-size=8192\" expo start --web",
    "lint": "expo lint",
    "build:web": "APP_VARIANT=production TAMAGUI_DISABLE_SLIDER_INTERVAL=1 EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export -p web && node scripts/write-web-manifest.mjs && node scripts/write-route-chunks.mjs && cp dist/+not-found.html dist/404.html && node scripts/check-web-csp.mjs && node scripts/check-web-chunks.mjs",
    "typecheck": "tsc --noEmit",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "test:unit": "node scripts/run-checks.mjs && node --test \"scripts/__tests__/*.test.mjs\"",
    "check:design": "node --no-warnings=ExperimentalWarning scripts/design-ratchet.mjs",
    "test:jest": "jest",
    "db:check": "node scripts/check-local-migrations.mjs",
    "db:health": "node scripts/db-health.mjs",
    "gen:types": "npx -y supabase@2.112.0 gen types typescript --local --schema public > types/database.ts.tmp && mv types/database.ts.tmp types/database.ts || { rm -f types/database.ts.tmp; exit 1; }",
    "test:security": "node scripts/check-local-migrations.mjs && files=$(node scripts/security-shard.mjs) && node --test --test-concurrency=1 --test-force-exit $files",
    "test:policy": "npm ci --prefix scripts/change-policy --ignore-scripts --no-audit --no-fund --silent && node --test \"scripts/change-policy/*.test.mjs\"",
    "smoke": "npm install --prefix smoke --no-audit --no-fund --silent && smoke/node_modules/.bin/playwright install --only-shell chromium && node smoke/smoke.mjs",
    "postinstall": "patch-package",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/josefin-sans": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/tenor-sans": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react": "10.75.2",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.95.2",
    "@tamagui/config": "2.7.7",
    "@tanstack/query-async-storage-persister": "^5.90.23",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.23",
    "@vercel/og": "0.11.1",
    "babel-preset-expo": "~58.0.0",
    "base64-arraybuffer": "^1.0.2",
    "burnt": "^0.13.0",
    "double-metaphone": "^2.0.1",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.1",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "jpeg-js": "^0.4.4",
    "maplibre-gl": "^5.24.0",
    "posthog-react-native": "^4.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-freeze": "^1.0.4",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pdf-thumbnail": "^2.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "2.7.7",
    "toqr": "0.1.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "patch-package": "^8.0.1",
    "pg": "^8.23.0",
    "postinstall-postinstall": "^2.1.0",
    "test-renderer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
