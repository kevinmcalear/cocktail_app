+// Cocktail: the icon cropped to a 32dp circle with a 2dp ring, like the iOS annotations.
+private fun GoogleMapsView.roundIcon(src: Bitmap, ringColor: Int): Bitmap {
+  val density = context.resources.displayMetrics.density
+  val size = (32 * density).toInt()
+  val ring = 2 * density
+  val radius = size / 2f
+  val scale = size.toFloat() / minOf(src.width, src.height)
+  val shader = BitmapShader(src, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP).apply {
+    setLocalMatrix(Matrix().apply {
+      setScale(scale, scale)
+      postTranslate((size - src.width * scale) / 2f, (size - src.height * scale) / 2f)
+    })
+  }
+  val out = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+  val canvas = Canvas(out)
+  canvas.drawCircle(radius, radius, radius, Paint(Paint.ANTI_ALIAS_FLAG).apply { this.shader = shader })
+  canvas.drawCircle(radius, radius, radius - ring / 2, Paint(Paint.ANTI_ALIAS_FLAG).apply {
+    style = Paint.Style.STROKE
+    strokeWidth = ring
+    color = ringColor
+  })
+  return out
+}
