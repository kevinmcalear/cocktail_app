{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/book/:key",
      "destination": "/book/[key]"
    },
    {
      "source": "/beer/:id",
      "destination": "/beer/[id]"
    },
    {
      "source": "/beer/:id/edit",
      "destination": "/beer/[id]/edit"
    },
    {
      "source": "/cocktail/:id",
      "destination": "/cocktail/[id]"
    },
    {
      "source": "/techniques/:id",
      "destination": "/techniques/[id]"
    },
    {
      "source": "/equipment/:id",
      "destination": "/equipment/[id]"
    },
    {
      "source": "/cocktail/:id/edit",
      "destination": "/cocktail/[id]/edit"
    },
    {
      "source": "/cocktail/:id/batch",
      "destination": "/cocktail/[id]/batch"
    },
    {
      "source": "/ingredient/:id",
      "destination": "/ingredient/[id]"
    },
    {
      "source": "/ingredient/:id/edit",
      "destination": "/ingredient/[id]/edit"
    },
    {
      "source": "/wine/:id",
      "destination": "/wine/[id]"
    },
    {
      "source": "/wine/:id/edit",
      "destination": "/wine/[id]/edit"
    },
    {
      "source": "/p/:id",
      "destination": "/p/[id]"
    },
    {
      "source": "/p/:id/claim",
      "destination": "/p/[id]/claim"
    },
    {
      "source": "/p/:id/menus/:edition",
      "destination": "/p/[id]/menus/[edition]"
    },
    {
      "source": "/settings/bar/:id",
      "destination": "/settings/bar/[id]"
    },
    {
      "source": "/settings/bar/:id/publishing",
      "destination": "/settings/bar/[id]/publishing"
    },
    {
      "source": "/settings/bar/:id/dilution",
      "destination": "/settings/bar/[id]/dilution"
    },
    {
      "source": "/settings/bar/:id/pricing",
      "destination": "/settings/bar/[id]/pricing"
    },
    {
      "source": "/settings/bar/:id/releases/:releaseId",
      "destination": "/settings/bar/[id]/releases/[releaseId]"
    },
    {
      "source": "/rankings/:itemId",
      "destination": "/rankings/[itemId]"
    },
    {
      "source": "/v/:slug",
      "destination": "/v/[slug]"
    },
    {
      "source": "/menus/:id",
      "destination": "/menus/[id]"
    },
    {
      "source": "/menus/:id/edit",
      "destination": "/menus/[id]/edit"
    },
    {
      "source": "/menus/:id/card",
      "destination": "/menus/[id]/card"
    },
    {
      "source": "/menus/:id/costing",
      "destination": "/menus/[id]/costing"
    },
    {
      "source": "/study/:deck",
      "destination": "/study/[deck]"
    },
    {
      "source": "/settings/bar/:id/brand",
      "destination": "/settings/bar/[id]/brand"
    },
    {
      "source": "/d/:id",
      "destination": "/d/[id]"
    },
    {
      "source": "/r/:id",
      "destination": "/r/[id]"
    },
    {
      "source": "/m/:id",
      "destination": "/m/[id]"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; script-src 'self' 'sha256-67fhrP0+BkBqmgGGXTtgiVO/9EQs3QruYNU/7fnRkI8='; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://*.posthog.com https://tiles.openfreemap.org https://photon.komoot.io blob: data:" },
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(maplibre-gl\\.css|favicon\\.ico|manifest\\.webmanifest|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|icon-maskable-512\\.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=2592000" }]
    }
  ]
}
